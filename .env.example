DOMAIN=karanravindra.com
ACME_EMAIL=you@example.com
TZ=America/New_York
# Cloudflare API token with Zone:DNS:Edit (and Zone:Zone:Read) on the domain
CF_DNS_API_TOKEN=

# Beszel: leave blank on first run, start the hub, click "Add System",
# copy the public key here, then `docker compose up -d beszel-agent`
BESZEL_KEY=

# Samba file server
SMB_USER=karan
SMB_PASSWORD=
# Host path of the mounted drive(s) to share
STORAGE_PATH=/mnt/storage

# News (orbit-news) -- the two passwords are required; the rest are optional overrides
NEWS_POSTGRES_PASSWORD=
NEWS_REDIS_PASSWORD=
# NEWS_TAG=latest              # pin e.g. sha-abc1234 to roll back
# NEWS_SUMMARIES=on
# NEWS_EMBED_BASE_URL=http://host.docker.internal:11434/v1
# NEWS_EMBED_MODEL=embeddinggemma-2:270m
# NEWS_EMBED_DIM=768
# NEWS_TOPIC_BASE_URL=http://host.docker.internal:11434
# NEWS_TOPIC_MODEL=lfm3
# NEWS_SUMMARY_BASE_URL=http://host.docker.internal:11434
# NEWS_SUMMARY_MODEL=lfm3
